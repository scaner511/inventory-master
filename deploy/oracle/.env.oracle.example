# ============================================================
# Despliegue en Oracle Cloud Always Free - variables de entorno
# Copia este archivo como "deploy/oracle/.env" y ajusta valores.
# OJO: Docker Compose lee el .env que esté en la misma carpeta
# que el docker-compose.yml (deploy/oracle/.env).
# ============================================================

# ---------- Base de datos ----------
POSTGRES_USER=inventario
# OBLIGATORIO: cambia esta contraseña (20+ caracteres aleatorios)
POSTGRES_PASSWORD=cambia-esta-password-postgres-por-una-fuerte
POSTGRES_DB=inventario_db

# ---------- Dominio de la API (necesario para HTTPS con Caddy) ----------
# Si no tienes dominio propio, usa DuckDNS gratuito: investigame.ddns.net
API_DOMAIN=api.tudominio.com

# ---------- Seguridad de la app (OBLIGATORIO cambiarlas) ----------
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave-jwt-por-una-aleatoria
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-password-admin
ADMIN_EMAIL=admin@mccea.local
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=cambia-esta-password-superadmin
SUPERADMIN_EMAIL=superadmin@mccea.local

# ---------- CORS (origen del panel, p. ej. Vercel) ----------
CORS_ORIGINS=https://tu-panel.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ---------- URL pública de la API y origen del panel ----------
# PUBLIC_BASE_URL debe coincidir con https:// + API_DOMAIN
PUBLIC_BASE_URL=https://api.tudominio.com
FRONTEND_ORIGIN=https://tu-panel.vercel.app

# ---------- Multi-proveedor ----------
DEFAULT_TENANT_NAME=Proveedor Principal
MAX_USERS_PER_TENANT=4

# ---------- Backups ----------
BACKUP_HOUR=03:00
BACKUP_RETENTION_DAYS=30
TZ=America/Mexico_City

# ---------- Google Drive (opcional) ----------
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_AUTO_UPLOAD=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Licencia offline ----------
# Misma SECRET_KEY que usa el generador de licencias. El valor por defecto
# coincide con offline_license.py, así las claves ya emitidas siguen validando.
LICENSE_PREFIX=MC26
LICENSE_DURATION_DAYS=30
# Si tu panel usó un LICENSE_SECRET_KEY distinto, ponlo aquí (sin comillas)
LICENSE_SECRET_KEY=6c5ab6f076be4a57a76a81c1dfc19000a6dd493b054f91b3520dc8206919fcf8

# ---------- PayPal: auto-activación de licencia (OPCIONAL) ----------
# 1. Entra a https://developer.paypal.com -> Apps & Credentials -> crea una app.
# 2. PAYPAL_MODE=sandbox para probar sin dinero real (client id/secret de Sandbox);
#    cambia a live cuando quieras cobrar de verdad.
# 3. (Recomendado) En la pestaña Webhooks de tu app de PayPal:
#      URL: https://inventorymasteros.duckdns.org/api/payments/paypal/webhook
#      Evento: PAYMENT.CAPTURE.COMPLETED
#      y copia el Webhook ID en PAYPAL_WEBHOOK_ID.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_LICENSE_DAYS=30
PAYPAL_PRICE_USD=75.0
PAYPAL_WEBHOOK_ID=

# ---------- Comportamiento general ----------
LOW_STOCK_THRESHOLD=5
DEFAULT_GENERIC_PASSWORD=Cambiar123!