# ============================================
# Configuración de Inventory Master OS Web
# Copia este archivo como .env y ajusta valores
# ============================================

# --- Base de datos PostgreSQL ---
DATABASE_URL=postgresql+psycopg2://inventario:inventario_secreto@localhost:5432/inventario_db

# --- Seguridad ---
SECRET_KEY=cambia-esta-clave-secreta-por-una-aleatoria-de-32-caracteres-minimo
# Minutos que dura el token JWT sin expirar
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- App ---
# Origenes permitidos (CORS). Para red local separa con comas:
# http://localhost:5173,http://192.168.1.100:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Usuario administrador inicial (se crea si no existe)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_EMAIL=admin@mccea.local

# --- Backup ---
# Carpeta donde se guardan los backups y reportes
BACKUP_DIR=./backups
# Hora local (HH:MM) del backup automático diario
BACKUP_HOUR=03:00
# Días que se conservan los backups antes de borrarse
BACKUP_RETENTION_DAYS=30

# --- Licencia ---
# Prefijo de las claves de licencia (ej. MC26)
LICENSE_PREFIX=MC26
# Días de validez por cada clave activada
LICENSE_DURATION_DAYS=30
