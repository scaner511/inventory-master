# ============================================
# Configuración de Inventory Master OS Web
# Copia este archivo como .env y ajusta valores
# ============================================

# --- Base de datos PostgreSQL ---
# Render entrega una URL tipo `postgres://...`; la app la convierte a
# `postgresql+psycopg2://...` automáticamente.
DATABASE_URL=postgresql+psycopg2://inventario:inventario_secreto@localhost:5432/inventario_db

# --- Seguridad ---
# OBLIGATORIO cambiarla en producción (puedes generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=cambia-esta-clave-secreta-por-una-aleatoria-de-32-caracteres-minimo
# Minutos que dura el token JWT sin expirar
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- App ---
# Origenes permitidos (CORS). Separa con comas. Agrega aquí los dominios
# personalizados; los subdominios *.vercel.app ya se permiten por defecto
# (ver CORS_ORIGIN_REGEX).
#   http://localhost:5173,https://tu-frontend.vercel.app,https://inventario.midominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex de orígenes adicionales permitidos (Vercel y dominios personalizados).
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Usuario administrador inicial (se crea si no existe)
ADMIN_USERNAME=admin
# OBLIGATORIO: cambia esta contraseña en producción
ADMIN_PASSWORD=admin1234
ADMIN_EMAIL=admin@mccea.local

# --- Super Admin global (multi-proveedor) ---
# Es el único usuario que puede crear proveedores (tenants). NO pertenece a
# ningún proveedor (tenant_id = NULL). Se crea automáticamente si no existe.
SUPERADMIN_USERNAME=superadmin
# OBLIGATORIO: cambia esta contraseña en producción
SUPERADMIN_PASSWORD=SuperAdmin123!
SUPERADMIN_EMAIL=superadmin@mccea.local

# --- Multi-proveedor ---
# Nombre del proveedor principal al que se migran los datos existentes
DEFAULT_TENANT_NAME=Proveedor Principal
# Máximo de usuarios por proveedor (1 admin + N adicionales)
MAX_USERS_PER_TENANT=4

# --- Backup ---
# Carpeta donde se guardan los backups y reportes
BACKUP_DIR=./backups
# Hora local (HH:MM) del backup automático diario
BACKUP_HOUR=03:00
# Días que se conservan los backups antes de borrarse
BACKUP_RETENTION_DAYS=30

# --- Licencia ---
# Prefijo de las claves de licencia (ej. MC26)
LICENSE_PREFIX=MC26
# Días de validez por cada clave activada
LICENSE_DURATION_DAYS=30
